# Modelo de configuração — copie este arquivo para ".env" e preencha os valores reais.
# O arquivo .env NUNCA deve ser compartilhado nem publicado (ex: GitHub) — ele já
# está listado no .gitignore justamente para isso.

# --- Banco de dados ---
# Recomendado: NÃO usar "root". Crie o usuário dedicado "sesi_app" rodando o
# script seguranca_mysql.sql (na raiz do projeto) e preencha aqui.
MYSQL_USER=sesi_app
MYSQL_PASSWORD=coloque_uma_senha_forte_aqui
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sesi_gestao

# --- Login (JWT) ---
# Gere uma chave aleatória (ex: python -c "import secrets; print(secrets.token_hex(32))")
# e mantenha ela FIXA — trocar a chave invalida todas as sessões ativas.
JWT_SECRET_KEY=coloque_uma_chave_aleatoria_longa_aqui
JWT_EXPIRE_MINUTES=480

# --- Primeiro admin ---
# Senha usada SOMENTE na primeira subida do sistema (quando ainda não existe
# nenhum usuário 'admin' no banco). Se ficar vazia, o sistema gera uma senha
# aleatória e mostra uma única vez no console. Depois da criação, esta linha
# não tem mais efeito nenhum — trocar a senha do admin é pela tela do Painel Admin.
ADMIN_DEFAULT_PASSWORD=

# Coloque este arquivo na raiz do projeto sistema_sesi,
# na mesma pasta onde estão requirements.txt e iniciar.bat.
# Não compartilhe/publique este arquivo (ex: não suba pro GitHub).

# --- Banco de dados ---
# Antes de usar: crie este usuário no MySQL (veja o passo a passo do Claude).
# Se preferir continuar usando root por enquanto, troque MYSQL_USER de volta
# para "root" e MYSQL_PASSWORD para a senha real do seu root.
MYSQL_USER=seu_usuario
MYSQL_PASSWORD=sua_senha
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sesi_gestao

# --- Login (JWT) ---
# Essa chave precisa ficar FIXA (sempre a mesma) para que os logins
# não sejam invalidados toda vez que o servidor for reiniciado.
JWT_SECRET_KEY=Seu_secret_key
JWT_EXPIRE_MINUTES=Seu_tempo_de_expiração
